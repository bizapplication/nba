# Required for the default repo-managed OpenClaw sidecar path.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENCLAW_GATEWAY_TOKEN=change-me-demo-token
OPENCLAW_DEMO_MODEL=deepseek/deepseek-v4-flash
OPENCLAW_REQUEST_TIMEOUT_MS=240000

# Optional local fallback for contributors who already have OpenClaw configured.
OPENCLAW_USE_GLOBAL_CLI=false
OPENCLAW_AUTH_SOURCE_HOME=

DEMO_ADMIN_EMAIL=admin@nba.demo
DEMO_ADMIN_PASSWORD=change-me-123
DEMO_ADMIN_NAME="NBA Demo Admin"
DEMO_JWT_SECRET=replace-this-with-a-long-random-secret

DEMO_WEB_PORT=3000
DEMO_CRM_PORT=3002
DEMO_PLATFORM_PORT=3003
DEMO_AGENT_PORT=3004
DEMO_ERP_PORT=3101
DEMO_OPENCLAW_PORT=18789

CRM_DB_HOST=127.0.0.1
CRM_DB_PORT=5432
CRM_DB_USER=postgres
CRM_DB_PASSWORD=postgres
CRM_DB_NAME=nba
CRM_DB_SCHEMA=crm

DEMO_COMMAND_ALLOWLIST=pnpm,git,ls,pwd,cat,rg,node,npm,npx
